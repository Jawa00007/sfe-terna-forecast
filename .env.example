# Copy to .env and fill in. Never commit .env.
# --- Terna Developer Portal (OAuth2 client credentials) ---
SFE_TERNA__CLIENT_ID=
SFE_TERNA__CLIENT_SECRET=
SFE_TERNA__TOKEN_URL=https://api.terna.it/transparency/oauth/accessToken
SFE_TERNA__BASE_URL=https://api.terna.it/transparency/v1.0

# Point the client at the local mock server during Phase 0 (no real credentials needed):
# SFE_TERNA__BASE_URL=http://127.0.0.1:8900
# SFE_TERNA__TOKEN_URL=http://127.0.0.1:8900/oauth/accessToken

# --- Storage ---
SFE_STORAGE__ROOT=./data
SFE_STORAGE__BACKEND=local

# --- Runtime ---
SFE_ENV=dev
SFE_LOG_LEVEL=INFO
